#include <windows.h>
#include "Version.h"
1 ICON "../../src/Luma.App/Assets/Luma.ico"
1 VERSIONINFO
FILEVERSION HDRJPEG_FILE_VERSION
PRODUCTVERSION HDRJPEG_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Luma HDR Converter"
      VALUE "FileVersion", HDRJPEG_VERSION
      VALUE "ProductName", "Luma HDR Converter"
      VALUE "ProductVersion", HDRJPEG_VERSION
      VALUE "LegalCopyright", "Copyright 2026 Luma contributors"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
