<UserControl x:Class="Luma.App.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="SettingCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </UserControl.Resources>
 <ScrollViewer x:Name="SettingsScroll" Padding="28,24,28,32" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
  <StackPanel x:Name="SettingsContent" Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch">
   <StackPanel Spacing="6" Margin="0,0,0,8"><TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="让好屏幕，也用来好好看照片。" Style="{StaticResource Hint}"/></StackPanel>
   <TextBlock Text="把 HDR 准备好" Style="{StaticResource SectionTitle}"/>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="14">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="01  开启 Windows HDR" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="DisplayNameText" Text="正在读取当前显示器…" Style="{StaticResource Hint}"/></StackPanel><Button x:Name="RefreshDisplayButton" Grid.Column="1" Style="{StaticResource GalleryAction}" Click="RefreshDisplayClick" VerticalAlignment="Top" ToolTipService.ToolTip="重新读取显示器信息" AutomationProperties.Name="重新读取显示器信息"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button></Grid>
    <TextBlock x:Name="HdrStateText" Text="正在读取 HDR 状态…" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="Windows 报告的峰值" Style="{StaticResource Hint}"/><TextBlock x:Name="PeakText" Text="—" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="当前 SDR 白色亮度" Style="{StaticResource Hint}"/><TextBlock x:Name="WhiteText" Text="—" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Grid>
    <TextBlock x:Name="DisplayHintText" Text="读取此窗口所在的屏幕；移到其他屏幕后会自动更新。" Style="{StaticResource Hint}"/>
    <Button x:Name="HdrSettingsButton" Content="Windows HDR 设置" Style="{StaticResource GalleryAction}" Click="HdrSettingsClick"/>
    <TextBlock Text="在系统“显示”设置中选中目标屏幕，再打开“使用 HDR”。此处显示的是系统开关状态，照片里的 RTX HDR 开关单独控制。" Style="{StaticResource Hint}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12">
    <TextBlock Text="02  用 Windows HDR 校准匹配屏幕" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
    <TextBlock Text="好屏幕也需要正确的亮度信息。微软的校准工具会帮助 Windows 了解屏幕能显示的暗部与高光，让 HDR 内容更好地匹配你的显示器。" Style="{StaticResource Hint}"/>
    <Button x:Name="CalibrationButton" Content="打开 HDR 校准" Click="CalibrationClick" Style="{StaticResource GalleryAction}"/>
    <TextBlock Text="已安装会直接打开；未安装会进入 Microsoft Store，由你下载安装。需要 Windows 11，并先开启 HDR。" Style="{StaticResource Hint}"/>
    <Expander x:Name="CalibrationGuide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="怎样校准，怎样看峰值？"><StackPanel Spacing="12">
     <TextBlock Text="将校准窗口移到要使用的 HDR 屏幕，在平时看照片的环境光下，按提示全屏完成测试并保存配置文件。拖动滑条，直到测试图案刚好消失；色彩饱和度不宜加得过多。" Style="{StaticResource Hint}"/>
     <TextBlock Text="上面的峰值来自 Windows / 显卡驱动，可能包含校准配置文件的结果，不是 Luma 实测，也不能单凭它判断校准合格。" Style="{StaticResource Hint}"/>
     <TextBlock Text="可以对照显示器标称峰值，但测试窗口面积、显示模式与厂商条件都会影响结果。不要为了“对上数字”照抄宣传值；完成校准后返回此页刷新，看看系统报告是否合理。" Style="{StaticResource Hint}"/>
     <TextBlock x:Name="FullFrameText" TextWrapping="Wrap" Style="{StaticResource Hint}"/>
     <HyperlinkButton Content="微软的 HDR 校准指南" NavigateUri="https://support.microsoft.com/windows/hardware/display-graphics/calibrate-your-hdr-display-using-the-windows-hdr-calibration-app" Padding="0"/>
    </StackPanel></Expander>
   </StackPanel></Border>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12">
    <TextBlock Text="03  打开照片，感受光影" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
    <TextBlock Text="普通照片：在预览顶部的“显示增强”里打开 RTX HDR，需要兼容的 NVIDIA RTX 显卡和驱动。照片本身带有 HDR 时，Luma 会直接显示，不再叠加 RTX HDR。" Style="{StaticResource Hint}"/>
    <TextBlock Text="按住空格对比原图；带增益图的 HDR 照片可对比 SDR 底图。VSR 是独立的 AI 超分开关，默认关闭。HDR 增强的是光影层次，不代表每个区域都更亮。" Style="{StaticResource Hint}"/>
   </StackPanel></Border>
   <TextBlock Text="按你的习惯使用" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12"><TextBlock Text="按照片类型筛选" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="在相册、收藏或全部照片页，点击顶部漏斗图标，可多选 HDR、实况和普通静态照片。多个类型表示匹配任意一项；相册首页只显示含匹配照片的相册。筛选会保留搜索与排序，也会记住你的选择，点击“显示全部”即可清除。首次识别在后台进行，之后在本次运行内复用结果。" Style="{StaticResource Hint}"/><TextBlock Text="HDR 指照片自带的 HDR 信息，不包含通过 RTX HDR 增强的普通照片；实况指仍保留视频的完整照片。文件暂时无法读取时会提示，重新连接后可刷新重试。" Style="{StaticResource Hint}"/></StackPanel></Border>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12"><TextBlock Text="让常用相册排在前面" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="右键相册卡片或侧边栏里的相册，选择“置顶相册”；再次右键可取消。键盘可按 Shift+F10 打开菜单。相册页顶部可按名称、添加顺序或照片数量排序，置顶相册始终在前；选择会自动保存。相册内的照片排序独立设置。" Style="{StaticResource Hint}"/></StackPanel></Border>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12">
    <TextBlock Text="让回忆动起来" FontWeight="SemiBold" FontSize="16"/>
    <TextBlock Text="支持的实况照片会在顶部显示同心圆图标。点击图标或按 L 播放 / 停止，Esc 停止播放；首次默认静音，之后会记住你的原声选择。图库的磨砂角标可快速识别 HDR 与实况照片。" Style="{StaticResource Hint}"/>
    <TextBlock Text="iPhone 实况照片需要保留配套 MOV；Android 动态照片请使用完整原片，部分分享方式会丢失视频。动态部分为 SDR 时也可使用 RTX HDR，播放期间暂停 VSR。首次播放可能需要等待初始化。" Style="{StaticResource Hint}"/>
    <TextBlock Text="缩放菜单的“适合窗口”完整显示照片，“填满窗口”铺满画面并裁去超出部分；旁边的适应按钮可一键恢复完整画面。" Style="{StaticResource Hint}"/>
    <HyperlinkButton Content="实况照片使用说明 ↗" NavigateUri="https://github.com/lueluelue12138/luma-hdr-photo-viewer/blob/main/docs/LIVE-PHOTOS.md" Padding="0,4" AutomationProperties.Name="在浏览器中打开实况照片的支持范围与使用说明"/>
   </StackPanel></Border>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12"><TextBlock Text="外观" FontWeight="SemiBold" FontSize="16"/><ComboBox x:Name="ThemeBox" Width="220" SelectionChanged="ThemeChanged" AutomationProperties.Name="应用主题"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox></StackPanel></Border>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12"><TextBlock Text="默认图片查看器" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="让双击照片直接打开 Luma。先注册应用，再由你在 Windows 默认应用设置中选择图片格式。" Style="{StaticResource Hint}"/><Button Content="在 Windows 中选择 Luma" Style="{StaticResource GalleryAction}" Click="DefaultAppsClick"/><TextBlock Text="如果列表中找不到 Luma，试试搜索 .jpg、.png 等文件类型，再选择 Luma。" Style="{StaticResource Hint}"/></StackPanel></Border>
   <TextBlock Text="关于 Luma" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>
   <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="12">
    <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
    <TextBlock Text="一个美观、轻便的 Windows 原生照片查看器，让自己的回忆也能在 HDR 屏幕上发光。免费、开源，照片保留在原文件夹。" Style="{StaticResource Hint}"/>
    <StackPanel Orientation="Horizontal" Spacing="20">
     <HyperlinkButton Content="GitHub 项目 ↗" NavigateUri="https://github.com/lueluelue12138/luma-hdr-photo-viewer" Padding="0,6" ToolTipService.ToolTip="查看项目介绍、源码与问题反馈" AutomationProperties.Name="在浏览器中打开 Luma 的 GitHub 项目"/>
     <HyperlinkButton Content="版本发布 ↗" NavigateUri="https://github.com/lueluelue12138/luma-hdr-photo-viewer/releases" Padding="0,6" ToolTipService.ToolTip="查看 GitHub Releases 发布记录与可用下载" AutomationProperties.Name="在浏览器中打开 Luma 的版本发布页面"/>
    </StackPanel>
    <Expander Header="支持的格式与使用须知" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="普通图片：JPEG、PNG、BMP、GIF、TIFF、ICO。GIF / 多页 TIFF 当前显示第一帧。" Style="{StaticResource Hint}"/><TextBlock Text="原生 HDR：Android Ultra HDR / ISO / Apple 增益图 JPEG，Apple / ISO 增益图 HEIC、PQ HEIC，以及线性 HDR JPEG XR。HEIC 需要 Windows HEIF / HEVC 扩展；AVIF HDR 暂未支持。" Style="{StaticResource Hint}"/><TextBlock Text="实况照片：已支持完整 Apple HEIC / JPEG + MOV 配对，以及已验证的 Android Motion Photo JPEG / HEIC。顶部实况图标或 L 播放，空格对照；首次默认静音，之后记住原声设置。原生 HDR 视频与 .livp 暂未支持。HEVC 视频可能需要 Windows HEVC 视频扩展。" Style="{StaticResource Hint}"/><TextBlock Text="没有 RTX 也能看普通照片与已支持的原生 HDR 照片。实际 HDR 输出仍需要开启 HDR 的屏幕；不可用时请查看照片“显示增强”中的状态。" Style="{StaticResource Hint}"/></StackPanel></Expander>
    <Button Content="打开本地数据目录" Style="{StaticResource GalleryAction}" Click="DataFolderClick"/>
    <TextBlock Text="This software contains source code provided by NVIDIA Corporation.&#xA;NVIDIA RTX™ Video SDK 组件及文档适用独立许可，应用目录中附有原文。" FontSize="12" Style="{StaticResource Hint}"/>
   </StackPanel></Border>
   <InfoBar x:Name="ActionError" IsOpen="False" Severity="Warning" Title="暂时无法打开" IsClosable="True"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
