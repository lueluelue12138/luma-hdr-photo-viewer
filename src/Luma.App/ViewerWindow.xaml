<Window x:Class="Luma.App.ViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Luma.App" xmlns:core="using:Luma.Core" Title="Luma">
 <Grid x:Name="Root" Language="zh-CN" PreviewKeyDown="ViewerPreviewKeyDown" PreviewKeyUp="ViewerPreviewKeyUp" KeyDown="ViewerKeyDown" PointerMoved="RootPointerMoved">
  <Grid.Resources><SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="Transparent"/><Thickness x:Key="ExpanderHeaderPadding">12,0</Thickness>
   <Style x:Key="EnhancementExpander" TargetType="Expander"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
   <Style x:Key="EnhancementAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Height" Value="36"/><Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,0"/></Style>
   <Style x:Key="FeaturePill" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,4"/></Style>
   <Style x:Key="DetailsLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
   <Style x:Key="DetailsValue" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="IsTextSelectionEnabled" Value="True"/></Style>
   <Style x:Key="DetailsAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Height" Value="58"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="4"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></Style>
  </Grid.Resources><Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="8,0,148,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Click="BackClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="图库" AutomationProperties.Name="返回图库"><FontIcon Glyph="&#xE72B;" FontSize="17"/></Button><Grid x:Name="TitleDrag" Grid.Column="1"><TextBlock x:Name="FileTitle" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"/></Grid></Grid>
  <Grid x:Name="Canvas" Grid.Row="1" Background="Transparent">
   <SwapChainPanel x:Name="Surface" Loaded="SurfaceLoaded" SizeChanged="SurfaceSizeChanged" CompositionScaleChanged="ScaleChanged"/>
   <SwapChainPanel x:Name="LiveSurface" Opacity="0" IsHitTestVisible="False"/>
   <Grid x:Name="InputLayer" Background="Transparent" IsTabStop="True" PointerPressed="CanvasPressed" PointerReleased="CanvasReleased" PointerCanceled="CanvasReleased" PointerCaptureLost="CanvasReleased" PointerMoved="CanvasMoved" PointerWheelChanged="CanvasWheel" Tapped="CanvasTapped" DoubleTapped="CanvasDoubleTapped" AutomationProperties.Name="照片预览，点击显示或隐藏控件，空格查看原图，方向键翻图，F 全屏"/>
   <Grid x:Name="LeftNavigationZone" Width="76" HorizontalAlignment="Left" Background="Transparent" Margin="0,90,0,142" PointerEntered="NavigationEntered" PointerExited="NavigationExited">
    <Button x:Name="PreviousButton" Click="PreviousClick" Style="{StaticResource ToolButton}" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center" Height="62" Background="{ThemeResource FloatingBrush}" AutomationProperties.Name="上一张照片" ToolTipService.ToolTip="上一张（←）"><FontIcon Glyph="&#xE76B;" FontSize="20"/></Button>
   </Grid>
   <Grid x:Name="RightNavigationZone" Width="76" HorizontalAlignment="Right" Background="Transparent" Margin="0,90,0,142" PointerEntered="NavigationEntered" PointerExited="NavigationExited">
    <Button x:Name="NextButton" Click="NextClick" Style="{StaticResource ToolButton}" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" Height="62" Background="{ThemeResource FloatingBrush}" AutomationProperties.Name="下一张照片" ToolTipService.ToolTip="下一张（→）"><FontIcon Glyph="&#xE76C;" FontSize="20"/></Button>
   </Grid>
   <Border x:Name="TopPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,14,20,0" CornerRadius="12" Background="{ThemeResource FloatingBrush}" BorderBrush="#33FFFFFF" BorderThickness="1" Translation="0,0,16" Padding="6" PointerEntered="PanelEntered" PointerExited="PanelExited">
    <Border.Shadow><ThemeShadow/></Border.Shadow><StackPanel Orientation="Horizontal" Spacing="3">
     <Button Click="RotateClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="旋转（R）" AutomationProperties.Name="旋转"><FontIcon Glyph="&#xE7AD;" FontSize="18"/></Button>
     <Button x:Name="FavoriteButton" Click="FavoriteClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="收藏（Ctrl+D）" AutomationProperties.Name="收藏"><FontIcon x:Name="FavoriteIcon" Glyph="&#xEB51;" FontSize="18"/></Button>
     <Border Width="1" Height="24" Margin="6,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
     <Button x:Name="ZoomOutButton" Click="ZoomOutClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="缩小（−）" AutomationProperties.Name="缩小"><FontIcon Glyph="&#xE71F;" FontSize="18"/></Button>
     <Button x:Name="ZoomInButton" Click="ZoomInClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="放大（+）" AutomationProperties.Name="放大"><FontIcon Glyph="&#xE8A3;" FontSize="18"/></Button>
     <Button x:Name="FitToWindowButton" Click="FitClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="适应窗口（Ctrl+0）" AutomationProperties.Name="适应窗口"><FontIcon Glyph="&#xE9A6;" FontSize="18"/></Button>
     <DropDownButton x:Name="FitButton" Content="适合窗口" Margin="3,0" Height="36" MinWidth="112"><DropDownButton.Flyout><MenuFlyout Opened="MenuOpened" Closed="MenuClosed"><MenuFlyout.SystemBackdrop><DesktopAcrylicBackdrop/></MenuFlyout.SystemBackdrop><MenuFlyoutItem Text="适合窗口（Ctrl+0）" Click="FitClick"/><MenuFlyoutItem Text="填满窗口" Click="FillClick" ToolTipService.ToolTip="保持原比例铺满窗口，超出部分裁切"/></MenuFlyout></DropDownButton.Flyout></DropDownButton>
     <Button x:Name="LiveButton" Click="LiveClick" Visibility="Collapsed" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="播放实况照片（L），空格仍用于 HDR 对照" AutomationProperties.Name="播放实况照片"><local:LivePhotoIcon x:Name="LiveIcon" Width="22" Height="22"/></Button>
     <Button x:Name="LiveMuteButton" Click="LiveMuteClick" Visibility="Collapsed" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="开启实况原声" AutomationProperties.Name="开启实况原声"><FontIcon x:Name="LiveMuteIcon" Glyph="&#xE74F;" FontSize="18"/></Button>
     <Button x:Name="FullScreenButton" Click="FullScreenClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="全屏（F / F11）" AutomationProperties.Name="全屏"><FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="18"/></Button>
     <Button x:Name="EnhancementButton" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="显示增强" AutomationProperties.Name="显示增强"><FontIcon Glyph="&#xE706;" FontSize="18"/><Button.Flyout><Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource GlassFlyoutPresenter}" Opened="EnhancementOpened" Closed="MenuClosed"><Flyout.SystemBackdrop><DesktopAcrylicBackdrop/></Flyout.SystemBackdrop><ScrollViewer x:Name="EnhancementScroll" MaxHeight="580" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Width="300" Spacing="14">
      <TextBlock Text="显示增强" FontSize="18" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="RTX HDR" VerticalAlignment="Center"/><ToggleSwitch x:Name="HdrSwitch" Grid.Column="1" MinWidth="128" AutomationProperties.Name="RTX HDR" IsEnabled="False" IsOn="False" OffContent="已关闭" OnContent="未生效" Toggled="EnhancementToggled"/></Grid><TextBlock x:Name="HdrReasonText" Text="正在检测 NVIDIA RTX Video SDK" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="VSR 超分辨率" VerticalAlignment="Center"/><ToggleSwitch x:Name="VsrSwitch" Grid.Column="1" MinWidth="128" AutomationProperties.Name="VSR 超分辨率" IsEnabled="False" IsOn="False" OffContent="已关闭" OnContent="未生效" Toggled="EnhancementToggled"/></Grid><TextBlock x:Name="VsrReasonText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
      <ComboBox x:Name="HdrPreset" Height="36" CornerRadius="8" SelectedIndex="1" SelectionChanged="PresetChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="HDR 风格"><ComboBoxItem Content="柔和"/><ComboBoxItem Content="自然"/><ComboBoxItem Content="鲜明"/></ComboBox>
      <Expander x:Name="BrightnessExpander" Header="亮度与显示器" Style="{StaticResource EnhancementExpander}"><StackPanel Spacing="10">
       <TextBlock x:Name="TuningExplanation" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
       <ToggleSwitch x:Name="AutoBrightnessSwitch" Header="匹配 Windows SDR 亮度" IsOn="True" OnContent="自动" OffContent="手动" Toggled="TuningChanged"/>
       <Grid><TextBlock x:Name="MiddleGrayLabel" Text="中间灰亮度" FontSize="13"/><TextBlock x:Name="MiddleGrayValue" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/></Grid><Slider x:Name="MiddleGraySlider" Minimum="10" Maximum="100" Value="100" StepFrequency="1" IsEnabled="False" ValueChanged="TuningValueChanged" AutomationProperties.Name="HDR 中间灰亮度"/>
       <ToggleSwitch x:Name="AutoPeakSwitch" Header="匹配显示器峰值" IsOn="True" OnContent="自动" OffContent="手动" Toggled="TuningChanged"/>
       <Grid><TextBlock x:Name="PeakLabel" Text="峰值亮度" FontSize="13"/><TextBlock x:Name="PeakValue" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/></Grid><Slider x:Name="PeakSlider" Minimum="400" Maximum="2000" Value="1000" StepFrequency="10" IsEnabled="False" ValueChanged="TuningValueChanged" AutomationProperties.Name="HDR 峰值亮度"/>
      </StackPanel></Expander>
      <Expander x:Name="DeviceExpander" Header="设备与运行状态" Style="{StaticResource EnhancementExpander}"><TextBlock x:Name="DisplayText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></Expander>
      <Button x:Name="OriginalButton" Content="按住查看原图（空格）" Style="{StaticResource EnhancementAction}" PointerPressed="OriginalPressed" PointerReleased="OriginalReleased" PointerCanceled="OriginalReleased" PointerCaptureLost="OriginalReleased"/>
     </StackPanel></ScrollViewer></Flyout></Button.Flyout></Button>
     <Button x:Name="InformationButton" Click="InfoClick" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="照片信息（I）" AutomationProperties.Name="照片信息"><FontIcon Glyph="&#xE946;" FontSize="18"/></Button>
     <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="更多" AutomationProperties.Name="更多"><FontIcon Glyph="&#xE712;" FontSize="18"/><Button.Flyout><MenuFlyout Opened="MenuOpened" Closed="MenuClosed"><MenuFlyout.SystemBackdrop><DesktopAcrylicBackdrop/></MenuFlyout.SystemBackdrop><MenuFlyoutItem Text="复制文件路径" Click="CopyPathClick"/><MenuFlyoutItem Text="在资源管理器中显示" Click="RevealClick"/><MenuFlyoutItem Text="打开其他照片…（Ctrl+O）" Click="OpenClick"/></MenuFlyout></Button.Flyout></Button>
    </StackPanel>
   </Border>
   <Border x:Name="BottomPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="920" Margin="36,0,36,28" CornerRadius="13" Background="{ThemeResource FloatingBrush}" BorderBrush="#33FFFFFF" BorderThickness="1" Translation="0,0,16" Padding="8" PointerEntered="PanelEntered" PointerExited="PanelExited">
    <Border.Shadow><ThemeShadow/></Border.Shadow><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="14"/></Grid.RowDefinitions><ListView x:Name="Filmstrip" Height="76" MaxWidth="820" SelectionMode="Single" SelectionChanged="ThumbnailSelected" Loaded="FilmstripLoaded" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" HorizontalAlignment="Stretch" IsItemClickEnabled="False" AutomationProperties.Name="缩略图导航，滚轮浏览列表"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/><AddDeleteThemeTransition/></TransitionCollection></ListView.ItemContainerTransitions><ListView.ItemContainerStyle><Style TargetType="ListViewItem">
      <Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Grid Width="100" Height="76">
       <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SelectionOutline.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
        <VisualState x:Name="Pressed"/>
        <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SelectionOutline.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/></VisualState.Setters></VisualState>
        <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="SelectionOutline.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/></VisualState.Setters></VisualState>
        <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="SelectionOutline.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/></VisualState.Setters></VisualState>
        <VisualState x:Name="SelectedUnfocused"><VisualState.Setters><Setter Target="SelectionOutline.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/></VisualState.Setters></VisualState>
       </VisualStateGroup></VisualStateManager.VisualStateGroups>
       <Border x:Name="SelectionOutline" Margin="2" Padding="2" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></Border>
      </Grid></ControlTemplate></Setter.Value></Setter>
     </Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="core:Photo"><Border Width="88" Height="62" CornerRadius="6"><local:Thumbnail FilePath="{Binding Path}" DecodeLogicalEdge="112" AutomationProperties.Name="{Binding Name}"/></Border></DataTemplate></ListView.ItemTemplate></ListView><ScrollBar x:Name="FilmstripBar" Grid.Row="1" Orientation="Horizontal" IndicatorMode="MouseIndicator" Height="14" Margin="4,0" Scroll="FilmstripBarScroll" AutomationProperties.Name="浏览缩略图列表"/></Grid>
     <TextBlock x:Name="PositionText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
    </Grid>
   </Border>
   <Border x:Name="InfoPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="340" Margin="16,82,20,0" CornerRadius="12" Background="{ThemeResource FloatingBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" PointerEntered="PanelEntered" PointerExited="PanelExited">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><TextBlock Text="照片信息" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Click="CloseInfoClick" HorizontalAlignment="Right" Style="{StaticResource ToolButton}" Height="30" Width="30" AutomationProperties.Name="关闭照片信息" ToolTipService.ToolTip="关闭（Esc）"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid>
     <Grid Grid.Row="1" ColumnSpacing="6" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Click="CopyPathClick" Style="{StaticResource DetailsAction}" AutomationProperties.Name="复制文件路径"><StackPanel Spacing="5"><FontIcon Glyph="&#xE8C8;" FontSize="16"/><TextBlock Text="复制路径" FontSize="12"/></StackPanel></Button>
      <Button Grid.Column="1" Click="CopyDetailsClick" Style="{StaticResource DetailsAction}" AutomationProperties.Name="复制照片详情"><StackPanel Spacing="5"><FontIcon Glyph="&#xE8A5;" FontSize="16"/><TextBlock Text="复制详情" FontSize="12"/></StackPanel></Button>
      <Button Grid.Column="2" Click="RevealClick" Style="{StaticResource DetailsAction}" AutomationProperties.Name="打开文件位置"><StackPanel Spacing="5"><FontIcon Glyph="&#xE8B7;" FontSize="16"/><TextBlock Text="打开位置" FontSize="12"/></StackPanel></Button>
     </Grid>
     <ScrollViewer x:Name="InfoScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
      <StackPanel Spacing="16">
       <StackPanel Spacing="8"><TextBlock Text="照片特性" Style="{StaticResource DetailsLabel}"/><StackPanel Orientation="Horizontal" Spacing="6">
        <Border Style="{StaticResource FeaturePill}"><TextBlock x:Name="InfoHdrFeature" Text="SDR" FontSize="12" FontWeight="SemiBold"/></Border>
        <Border x:Name="InfoLiveFeature" Style="{StaticResource FeaturePill}" Visibility="Collapsed" AutomationProperties.Name="实况照片" ToolTipService.ToolTip="实况照片，含完整动态视频"><local:LivePhotoIcon Width="18" Height="18"/></Border>
        <Border Style="{StaticResource FeaturePill}"><TextBlock x:Name="InfoFormatFeature" FontSize="12"/></Border>
       </StackPanel></StackPanel>
       <StackPanel x:Name="InfoLiveSection" Spacing="4" Visibility="Collapsed"><TextBlock Text="实况照片" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoLiveSummary" Style="{StaticResource DetailsValue}" FontSize="13"/></StackPanel>
       <TextBlock x:Name="InfoReadStatus" Style="{StaticResource DetailsLabel}" TextWrapping="Wrap"/>
       <StackPanel Spacing="4"><TextBlock Text="文件名" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoFileName" Style="{StaticResource DetailsValue}" FontWeight="SemiBold"/></StackPanel>
       <StackPanel Spacing="4"><TextBlock Text="尺寸与大小" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoDimensions" Style="{StaticResource DetailsValue}"/><TextBlock x:Name="InfoSize" Style="{StaticResource DetailsValue}"/><TextBlock x:Name="InfoResolution" Style="{StaticResource DetailsLabel}" TextWrapping="Wrap"/></StackPanel>
       <StackPanel x:Name="InfoDates" Spacing="4"><TextBlock Text="日期与时间" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoDateText" Style="{StaticResource DetailsValue}"/></StackPanel>
       <StackPanel x:Name="InfoCameraSection" Spacing="4" Visibility="Collapsed"><TextBlock Text="设备与拍摄" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoCamera" Style="{StaticResource DetailsValue}" FontWeight="SemiBold"/><TextBlock x:Name="InfoLens" Style="{StaticResource DetailsValue}"/><TextBlock x:Name="InfoExposure" Style="{StaticResource DetailsValue}"/></StackPanel>
       <StackPanel Spacing="4"><TextBlock Text="色彩与显示" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoHdr" Style="{StaticResource DetailsValue}"/><TextBlock x:Name="InfoColor" Style="{StaticResource DetailsLabel}" TextWrapping="Wrap"/><TextBlock x:Name="InfoViewing" Style="{StaticResource DetailsLabel}" TextWrapping="Wrap"/></StackPanel>
       <StackPanel x:Name="InfoGpsSection" Spacing="4" Visibility="Collapsed"><TextBlock Text="拍摄位置（经纬度）" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoGps" Style="{StaticResource DetailsValue}"/></StackPanel>
       <StackPanel Spacing="4"><TextBlock Text="文件位置" Style="{StaticResource DetailsLabel}"/><TextBlock x:Name="InfoFilePath" Style="{StaticResource DetailsValue}"/></StackPanel>
       <Expander x:Name="InfoMore" Header="其他拍摄信息" Style="{StaticResource EnhancementExpander}" IsExpanded="False"><StackPanel Spacing="12">
        <TextBox x:Name="InfoSearch" PlaceholderText="搜索信息或参数" AutomationProperties.Name="搜索照片信息" Loaded="InfoSearchLoaded" TextChanged="InfoSearchChanged"/>
        <TextBlock x:Name="InfoEmptySearch" Text="没有匹配的信息" Style="{StaticResource DetailsLabel}" Visibility="Collapsed"/>
        <ItemsControl x:Name="InfoMetadataGroups"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="8" Margin="0,0,0,16">
         <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
         <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource DetailsLabel}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource DetailsValue}" FontSize="13"/>
         </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
   <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,14,20,0" CornerRadius="10" Background="{ThemeResource FloatingBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8" IsHitTestVisible="False"><TextBlock x:Name="StatusText" Text="SDR · 原图" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12"/></Border>
   <local:LoadingIndicator x:Name="Loading" IsActive="False" Width="40" Height="40" Visibility="Collapsed"/>
   <Border x:Name="ErrorPanel" Visibility="Collapsed" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource FloatingBrush}" CornerRadius="12" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE7BA;"/><TextBlock Text="无法打开这张照片" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="打开其他照片…" Click="OpenClick" HorizontalAlignment="Center"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
