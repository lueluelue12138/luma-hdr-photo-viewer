<Window x:Class="Luma.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Luma.App" xmlns:core="using:Luma.Core" Title="Luma">
 <Grid x:Name="Root" Language="zh-CN" AllowDrop="True" DragOver="DragOver" Drop="DropItems">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleDrag" Margin="16,0,148,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="Assets/Square44x44Logo.png" Width="28" Height="28" Stretch="Uniform"/><TextBlock Text="Luma" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
  </Grid>
  <AutoSuggestBox x:Name="Search" PlaceholderText="搜索照片或相册" Width="370" HorizontalAlignment="Center" VerticalAlignment="Center" QueryIcon="Find" TextChanged="SearchChanged" AutomationProperties.Name="搜索照片或相册"/>
  <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" PaneDisplayMode="Left" OpenPaneLength="218" CompactPaneLength="48" SelectionChanged="NavigationChanged" IsSettingsVisible="True">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="AllItem" Content="所有照片" Tag="all"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="AlbumsItem" Content="相册" Tag="albums"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="收藏" Tag="favorites"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="最近打开" Tag="recent"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemHeader Content="我的相册"/>
   </NavigationView.MenuItems>
   <Grid>
   <Grid x:Name="Gallery" Padding="28,22,28,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Text="相册" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Name="OpenPhotoButton" Click="OpenPhotoClick" Style="{StaticResource GalleryAction}" ToolTipService.ToolTip="打开照片（Ctrl+O）" AutomationProperties.Name="打开照片"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xED25;" FontSize="16"/><TextBlock x:Name="OpenPhotoLabel" Text="打开照片" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource GalleryAction}" ToolTipService.ToolTip="刷新文件夹" AutomationProperties.Name="刷新文件夹"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
     <ComboBox x:Name="SortBox" Width="126" Height="36" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SortChanged" AutomationProperties.Name="照片排序" ToolTipService.ToolTip="照片排序"><ComboBoxItem Content="名称" Tag="name"/><ComboBoxItem Content="最新优先" Tag="newest"/><ComboBoxItem Content="最早优先" Tag="oldest"/></ComboBox>
     <Button x:Name="ImportButton" Click="ImportClick" Style="{StaticResource GalleryAction}" AutomationProperties.Name="导入文件夹" ToolTipService.ToolTip="导入文件夹"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE710;" FontSize="16"/><TextBlock x:Name="ImportLabel" Text="导入文件夹" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel></Grid>
    <Grid x:Name="GallerySummary" Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="CountText" Text="0 个相册" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
     <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="FolderText" Grid.Column="1" Text="照片保留在原文件夹" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></Grid>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><local:LoadingIndicator x:Name="ScanProgress" IsActive="False" Width="18" Height="18" Visibility="Collapsed"/><TextBlock x:Name="ScanText" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </Grid>
    <ScrollViewer x:Name="GalleryScroll" Grid.Row="2" Margin="0,0,-18,0" Padding="0,4,28,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid>
      <ItemsRepeater x:Name="AlbumsRepeat"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="216" MinColumnSpacing="18" MinRowSpacing="24" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="core:Album">
       <Button Tag="{Binding}" Click="AlbumClick" RightTapped="AlbumRightTapped" PointerEntered="CardEntered" PointerExited="CardExited" Style="{StaticResource GalleryCard}" AutomationProperties.Name="{Binding Name}"><StackPanel Spacing="7"><Border Height="176" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><local:Thumbnail FilePath="{Binding Cover}" AlbumId="{Binding Id}"/></Border><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CountLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel></Button>
      </DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
      <ItemsRepeater x:Name="PhotosRepeat" Visibility="Collapsed"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="196" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="core:Photo">
       <Button Tag="{Binding}" Click="PhotoClick" RightTapped="PhotoRightTapped" PointerEntered="CardEntered" PointerExited="CardExited" Style="{StaticResource GalleryCard}" AutomationProperties.Name="{Binding Name}"><StackPanel Spacing="6"><Border Height="172" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><local:Thumbnail FilePath="{Binding Path}"/></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="14"/><TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Button>
      </DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
     </Grid>
    </ScrollViewer>
    <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="420"><FontIcon Glyph="&#xEB9F;" FontSize="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0.8"/><TextBlock x:Name="EmptyTitle" Text="让照片的光影，有个家" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="导入一个文件夹，开始整理你的照片。&#xA;照片始终保留在原位置。" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="导入文件夹" Click="ImportClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"/></StackPanel>
   </Grid>
   <ContentControl x:Name="SettingsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
