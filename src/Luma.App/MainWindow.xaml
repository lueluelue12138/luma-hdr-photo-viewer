<Window x:Class="Luma.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Luma.App" xmlns:core="using:Luma.Core" Title="Luma">
 <Grid x:Name="Root" Language="zh-CN" AllowDrop="True" DragOver="DragOver" Drop="DropItems">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleDrag" Margin="16,0,148,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Border Background="#0785F7" Width="22" Height="22" CornerRadius="6"><FontIcon Glyph="&#xEB9F;" Foreground="White" FontSize="14"/></Border><TextBlock Text="Luma" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
  </Grid>
  <AutoSuggestBox x:Name="Search" PlaceholderText="搜索照片或相册" Width="370" HorizontalAlignment="Center" VerticalAlignment="Center" QueryIcon="Find" TextChanged="SearchChanged" AutomationProperties.Name="搜索照片或相册"/>
  <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" PaneDisplayMode="Left" OpenPaneLength="218" CompactPaneLength="48" SelectionChanged="NavigationChanged" IsSettingsVisible="True">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="AllItem" Content="所有照片" Tag="all"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="AlbumsItem" Content="相册" Tag="albums"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="收藏" Tag="favorites"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="最近打开" Tag="recent"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemHeader Content="我的相册"/>
   </NavigationView.MenuItems>
   <Grid>
   <Grid x:Name="Gallery" Padding="28,22,28,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Text="相册" FontSize="28" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
     <Button Click="OpenPhotoClick" ToolTipService.ToolTip="打开照片" AutomationProperties.Name="打开照片"><FontIcon Glyph="&#xE8E5;" FontSize="16"/></Button>
     <Button Click="RefreshClick" ToolTipService.ToolTip="刷新文件夹" AutomationProperties.Name="刷新文件夹"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
     <ComboBox x:Name="SortBox" Width="126" SelectedIndex="0" SelectionChanged="SortChanged" AutomationProperties.Name="照片排序"><ComboBoxItem Content="名称" Tag="name"/><ComboBoxItem Content="最新优先" Tag="newest"/><ComboBoxItem Content="最早优先" Tag="oldest"/></ComboBox>
     <Button Click="ImportClick" Padding="14,9" AutomationProperties.Name="导入文件夹" ToolTipService.ToolTip="导入文件夹"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock x:Name="ImportLabel" Text="导入文件夹"/></StackPanel></Button>
    </StackPanel></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20"><TextBlock x:Name="CountText" Text="0 个相册" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><local:LoadingIndicator x:Name="ScanProgress" IsActive="False" Width="18" Height="18" Visibility="Collapsed"/><TextBlock x:Name="ScanText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid>
      <ItemsRepeater x:Name="AlbumsRepeat"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="216" MinColumnSpacing="18" MinRowSpacing="24" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="core:Album">
       <Button Tag="{Binding}" Click="AlbumClick" RightTapped="AlbumRightTapped" PointerEntered="CardEntered" PointerExited="CardExited" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding Name}"><StackPanel Spacing="7"><Border Height="176" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><local:Thumbnail FilePath="{Binding Cover}"/></Border><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CountLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel></Button>
      </DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
      <ItemsRepeater x:Name="PhotosRepeat" Visibility="Collapsed"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="196" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="core:Photo">
       <Button Tag="{Binding}" Click="PhotoClick" RightTapped="PhotoRightTapped" PointerEntered="CardEntered" PointerExited="CardExited" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding Name}"><StackPanel Spacing="6"><Border Height="172" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><local:Thumbnail FilePath="{Binding Path}"/></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="14"/><TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Button>
      </DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
     </Grid>
    </ScrollViewer>
    <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="420"><FontIcon Glyph="&#xEB9F;" FontSize="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0.8"/><TextBlock x:Name="EmptyTitle" Text="让照片的光影，有个家" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="导入一个文件夹，开始整理你的照片。&#xA;照片始终保留在原位置。" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="导入文件夹" Click="ImportClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,20,0,0"><FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="FooterText" Text="照片保留在原文件夹" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="32,24" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel Spacing="22" MaxWidth="700" HorizontalAlignment="Left">
    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="ThemeBox" Width="220" SelectionChanged="ThemeChanged" AutomationProperties.Name="应用主题"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox>
    <TextBlock Text="默认图片查看器" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="将 Luma 添加到开始菜单及可选图片查看器，在 Windows 设置中选择支持的图片格式。" TextWrapping="Wrap" LineHeight="21" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="在 Windows 中选择 Luma" Click="DefaultAppsClick"/>
    <TextBlock Text="如果应用列表未显示 Luma，可在默认应用页面输入 .jpg、.png 等文件类型，再选择 Luma。" TextWrapping="Wrap" LineHeight="21" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Text="显示与增强" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="EnvironmentText" Text="RTX HDR 可增强普通照片的高光与色彩，需要兼容的 NVIDIA RTX 显卡及开启 HDR 的显示器。&#xA;VSR 用于 AI 超分辨率，与 HDR 独立控制，默认关闭。&#xA;在照片顶部的“显示增强”面板中查看支持情况并调整效果。" TextWrapping="Wrap" LineHeight="21" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Text="关于 Luma" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Luma 0.1.2 · Windows 原生图库&#xA;支持 JPEG、PNG、BMP、GIF、TIFF、JPEG XR、ICO。&#xA;GIF / 多页 TIFF 当前显示第一帧；支持含线性 HDR 数据的 JPEG XR。" TextWrapping="Wrap" LineHeight="21" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Text="This software contains source code provided by NVIDIA Corporation.&#xA;NVIDIA RTX™ Video SDK 组件及文档适用 NVIDIA 独立许可，应用目录中附有原文。" FontSize="12" TextWrapping="Wrap" LineHeight="21" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button Content="打开本地数据目录" Click="DataFolderClick"/>
   </StackPanel></ScrollViewer>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
